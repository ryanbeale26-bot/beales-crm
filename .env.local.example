# Copy this file to .env.local and fill in the values from your Supabase project.
# In the Supabase dashboard: Project Settings -> API
#
# .env.local is git-ignored. Never commit real keys.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose in the browser — it can only do
# what Row Level Security allows a signed-in user to do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where this app is running. Used to build magic-link redirect URLs.
#
# Locally, leave this as http://localhost:3000.
#
# On Vercel you do NOT need to set it: the app falls back to Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL, which is filled in automatically. Set it only
# once there is a custom domain (e.g. https://crm.bealesllc.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# The nightly ingest (Phase 7)
# ---------------------------------------------------------------------------
# These DO go on Vercel, and the difference between them and the service role
# key below is the whole point.
#
# INGEST_USER_* is an ordinary login — a profile flagged is_service, created
# with `npm run user:create -- --email … --name "Nightly ingest" --service`.
# It is a member like anyone else: RLS applies to every write, it cannot read
# pay rates, it cannot administer users, and audit_log records it by name on
# every row it touches. If it leaked, an attacker would have one member account.
#
# The service role key would give them every row in the database with security
# switched off, and no audit trail, and no way to tell it had happened. That is
# why one of these lives on Vercel and the other never does.
#
# CRON_SECRET is what Vercel Cron sends in its Authorization header, so that
# /api/cron/ingest answers to Vercel and to nobody else on the internet.
INGEST_USER_EMAIL=
INGEST_USER_PASSWORD=
CRON_SECRET=

# ---------------------------------------------------------------------------
# Granola (Phase 7c)
# ---------------------------------------------------------------------------
# A PERSONAL API key from the Granola desktop app, starting `grn_`. Read-only.
#
# It must be a personal key, not a workspace key, and the difference is not
# cosmetic: a workspace key cannot see private notes and fails by returning a
# handful of Team Space notes rather than by erroring. If the probe ever reports
# far fewer notes than you have, suspect the key before the code.
GRANOLA_API_KEY=

# ---------------------------------------------------------------------------
# Microsoft Graph — mail and calendar (Phase 7b)
# ---------------------------------------------------------------------------
# One app registration in Entra ID, application permissions Mail.Read and
# Calendars.Read, with admin consent granted.
#
# THE PART THAT MATTERS MOST IS NOT IN THIS FILE. Application permissions are
# tenant-wide by default: without an ApplicationAccessPolicy this client id can
# read EVERY mailbox in the tenant — payroll, HR, the owners' private mail. The
# policy scopes it to a mail-enabled security group, and it is verified with:
#
#   Test-ApplicationAccessPolicy -Identity ryan@bealesllc.com -AppId <client-id>
#      -> Granted
#   Test-ApplicationAccessPolicy -Identity <anyone else>      -AppId <client-id>
#      -> Denied
#
# Adding a colleague later is a membership change on that group. No code, no
# redeploy.
#
# The secret EXPIRES. Ours was issued 2026-08-16 and expires 2028-08-16, and the
# failure mode is silent: the nightly job simply stops logging and nobody
# connects it to a credential two years old. Renew it by 2028-08-01.
#
# Copy the secret VALUE, not the Secret ID — Entra shows both, the value is only
# visible immediately after creation, and a Secret ID here fails authentication
# with an error that does not say so.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# The "service_role" / secret key. This BYPASSES Row Level Security completely.
# It is used only by scripts in /scripts (creating user accounts), which run on
# your own machine. Nothing under /src reads it, and nothing ever should.
#
# DO NOT add this to Vercel. The deployed app does not need it, and a key that
# bypasses every security rule has no business sitting in a web host's
# environment where a single mistaken import would expose the whole database.
# Keep it here, locally, only.
SUPABASE_SERVICE_ROLE_KEY=
