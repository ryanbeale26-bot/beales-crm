# Copy this file to .env.local and fill in the values from your Supabase project.
# In the Supabase dashboard: Project Settings -> API
#
# .env.local is git-ignored. Never commit real keys.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose in the browser — it can only do
# what Row Level Security allows a signed-in user to do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where this app is running. Used to build magic-link redirect URLs.
# Locally this is http://localhost:3000. On Vercel, set it to the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The "service_role" / secret key. This BYPASSES Row Level Security completely.
# It is used only by scripts in /scripts (creating user accounts), never by the
# app itself, and it must never appear in any file under /src.
# On Vercel, add this as a normal (not NEXT_PUBLIC_) environment variable.
SUPABASE_SERVICE_ROLE_KEY=
